// Start the fixture with docker compose --profile test up -d ssh.
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ssh-mcp-server": {
      "type": "local",
      "command": [
        "node",
        "build/legacy-stdio.js",
        "--host=127.0.0.1",
        "--port=2228",
        "--user=test",
        "--password=secret",
        "--timeout=60000"
      ],
      "enabled": true,
    },
  },
}
